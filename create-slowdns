#!/bin/bash
clear
clear
clear
NC='\033[0m'; RED='\033[1;31m'; GREEN='\033[1;32m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'; YELLOW='\033[1;33m'; PURPLE='\033[1;95m'
nama=$(cat /etc/xray/username 2>/dev/null || echo "Admin")
clear
echo -e ""
echo -e "${YELLOW}══════════════════════════════════════════════════${NC}"
echo -e "              ${PURPLE}CREATE SLOWDNS ACCOUNT${NC}"
echo -e "${YELLOW}══════════════════════════════════════════════════${NC}"
echo -e ""
echo -e " ${WHITE}Masukkan Data Akun Baru:${NC}"
echo -e ""
read -p "   Username       : " Login
read -p "   Password       : " Pass
read -p "   Expired (Days) : " masaaktif
if [[ -z $Login || -z $Pass || -z $masaaktif ]]; then echo -e "\n  ${RED}Error: Data tidak boleh kosong!${NC}"; sleep 2; menu-slowdns; exit; fi
echo -e "\n  ${YELLOW}Memproses pembuatan akun...${NC}"
IP=$(curl -sS ipv4.icanhazip.com 2>/dev/null)
domen=$(cat /etc/xray/domain 2>/dev/null)
NS=$(cat /root/nsdomain 2>/dev/null); [[ -z "$NS" ]] && NS=$(cat /etc/xray/dns 2>/dev/null)
PUB=$(cat /etc/slowdns/server.pub 2>/dev/null)
tgl=$(date -d "$masaaktif days" +"%d"); bln=$(date -d "$masaaktif days" +"%b"); thn=$(date -d "$masaaktif days" +"%Y"); expe="$tgl $bln, $thn"
tgl2=$(date +"%d"); bln2=$(date +"%b"); thn2=$(date +"%Y"); tnggl="$tgl2 $bln2, $thn2"
id $Login &>/dev/null && userdel -f $Login
useradd -e `date -d "$masaaktif days" +"%Y-%m-%d"` -s /bin/false -M $Login
echo -e "$Pass\n$Pass\n" | passwd $Login &> /dev/null
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 2)
URL="https://api.telegram.org/bot$KEY/sendMessage"
TEXT="<code>-----------------------</code>
<b>SSH & SLOWDNS CREATED</b>
<code>-----------------------</code>
<code>Username     :</code> <code>$Login</code>
<code>Password     :</code> <code>$Pass</code>
<code>Expired      :</code> <code>$masaaktif Hari</code>
<code>-----------------------</code>
<code>IP Server    :</code> <code>$IP</code>
<code>NS Domain    :</code> <code>$NS</code>
<code>Pub Key      :</code> <code>$PUB</code>
<code>-----------------------</code>"
if [[ -n "$CHATID" && -n "$KEY" ]]; then curl -s --max-time 10 -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" "$URL" >/dev/null; fi
clear
echo -e ""
echo -e "${YELLOW}══════════════════════════════════════════════════${NC}"
echo -e "            ${PURPLE}SUCCESS CREATE SLOWDNS${NC}"
echo -e "${YELLOW}══════════════════════════════════════════════════${NC}"
echo -e " ${CYAN}Username${NC}       : ${WHITE}${Login}${NC}"
echo -e " ${CYAN}Password${NC}       : ${WHITE}${Pass}${NC}"
echo -e "${YELLOW}──────────────────────────────────────────────────${NC}"
echo -e " ${CYAN}IP Server${NC}      : ${WHITE}${IP}${NC}"
echo -e " ${CYAN}Hostname${NC}       : ${WHITE}${domen}${NC}"
echo -e " ${CYAN}NS Domain${NC}      : ${WHITE}${NS}${NC}"
echo -e " ${CYAN}Pub Key${NC}        : ${WHITE}${PUB}${NC}"
echo -e "${YELLOW}──────────────────────────────────────────────────${NC}"
echo -e " ${CYAN}Created${NC}        : ${WHITE}$tnggl${NC}"
echo -e " ${CYAN}Expired${NC}        : ${WHITE}$expe${NC}"
echo -e " ${CYAN}Active${NC}         : ${WHITE}$masaaktif Hari${NC}"
echo -e "${YELLOW}══════════════════════════════════════════════════${NC}"
echo -e " ${PURPLE}Terimakasih Telah Menggunakan Script Credit${NC}"
echo -e " ${PURPLE}$nama${NC}"
echo -e ""
read -n 1 -s -r -p " Press any key to back on menu"
menu
